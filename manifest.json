{
  "manifest_version": 3,
  "name": "Chess Position Notes",
  "version": "0.1.0",
  "description": "Keep your own notes for each chess position on Chessly.",

  "browser_specific_settings": {
    "gecko": {
      "id": "chess-position-notes@my-chessly.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "content_scripts": [
    {
      "matches": ["https://chessly.com/*", "https://*.chessly.com/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ]
}
